# =============================================================================
# Lakshmi Q2 — Variables de Entorno
# Copiar a .env y completar con valores reales antes de ejecutar
# =============================================================================

# Clave secreta para sesiones Flask (cambiar en producción)
SECRET_KEY=cambiar-esta-clave-secreta-en-produccion

# Entorno Flask: development | production
FLASK_ENV=development

# --- Configuración SMTP (para alertas por email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password

# --- Token API Banxico (INPC y tipo de cambio USD/MXN) ---
# Obtener en: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=tu-token-banxico

# --- ElevenLabs Conversational AI (asistente de voz) ---
# Agent ID del agente configurado en https://elevenlabs.io/app/agents
VITE_ELEVENLABS_AGENT_ID=tu-agent-id-aqui